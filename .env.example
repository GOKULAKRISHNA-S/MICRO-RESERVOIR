# Micro-Reservoir Intelligence Configuration
# Copy this file to .env and adjust variables as needed

# Environment & Run Mode
ENVIRONMENT=development
LOG_LEVEL=INFO

# Detection & Index Configuration
# Available options: NDWI, MNDWI, AWEI
DEFAULT_WATER_INDEX=NDWI
NDWI_WATER_THRESHOLD=0.0
MNDWI_WATER_THRESHOLD=0.0
AWEI_WATER_THRESHOLD=0.0

# Alert Thresholds (Percentage changes)
ALERT_DECLINE_THRESHOLD_PERCENT=-10.0
ALERT_CRITICAL_DECLINE_THRESHOLD_PERCENT=-25.0
ALERT_INCREASE_THRESHOLD_PERCENT=10.0

# Quality Constraints
MAX_CLOUD_COVER_PERCENT=20.0
MIN_VALID_PIXEL_RATIO=0.70
MIN_RESERVOIR_PIXELS=5

# Spatial Defaults
DEFAULT_PIXEL_RESOLUTION_M=10.0
DEFAULT_CRS=EPSG:32643

# Paths (Relative to repository root)
DATA_DIR=data
SAMPLE_MANIFEST_PATH=data/samples/sample_manifest.json
PROCESSED_OUTPUT_DIR=data/processed
